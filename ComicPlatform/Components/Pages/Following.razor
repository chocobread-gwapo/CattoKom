@page "/following"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ComicPlatform.Data
@using ComicPlatform.Models
@using System.Security.Claims
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Following</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="browse">
    <div class="page-head">
        <h1>Following</h1>
        @if (_items.Count > 0)
        {
            <div class="pills">
                <button class="pill @(_sortByUpdates ? "on" : "")" @onclick="() => _sortByUpdates = true">Updates</button>
                <button class="pill @(!_sortByUpdates ? "on" : "")" @onclick="() => _sortByUpdates = false">Recently followed</button>
            </div>
        }
    </div>

    @if (!_loaded)
    {
        <p class="loading">Loading...</p>
    }
    else if (_items.Count == 0)
    {
        <div class="empty">
            <p>You're not following anything yet.</p>
            <a href="/">Browse series</a>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var item in Sorted)
            {
                <div class="panel-wrap">
                    <a class="panel" href="@($"/series/{item.Series.Id}")">
                        <div class="cover">
                            @if (!string.IsNullOrEmpty(item.Series.CoverImageUrl))
                            {
                                <img src="@item.Series.CoverImageUrl" alt="@item.Series.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="cover-placeholder">@item.Series.Title</div>
                            }
                            @if (item.HasNewChapter)
                            {
                                <span class="new">NEW</span>
                            }
                        </div>
                        <div class="panel-info">
                            <h2>@item.Series.Title</h2>
                            <span class="sub">
                                <span class="status status-@item.Series.Status.ToString().ToLower()">@item.Series.Status</span>
                                @if (item.LastChapterAt is not null)
                                {
                                    <span class="updated">@item.LastChapterAt?.ToString("MMM d, yyyy")</span>
                                }
                            </span>
                        </div>
                    </a>
                    <button class="unfollow" @onclick="() => Unfollow(item)" aria-label="Unfollow @item.Series.Title">&times;</button>
                </div>
            }
        </div>
    }
</div>

<style>
    .browse { font-family: 'Public Sans', sans-serif; color: var(--ink); max-width: 1000px; margin: 0 auto; padding: 1.5rem 0 4rem; }

    .page-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem; padding-bottom: 1rem; border-bottom: 3px solid var(--ink); }
    .page-head h1 { font-family: 'Fraunces', serif; font-weight: 900; font-size: clamp(1.5rem, 4vw, 2rem); margin: 0; }

    .pills { display: flex; gap: 0.5rem; }
    .pill { font: inherit; font-size: 0.8rem; font-weight: 600; padding: 0.35rem 0.85rem; cursor: pointer; background: transparent; color: var(--ink); border: 1.5px solid var(--ink); }
    .pill:hover { background: var(--panel-bg); }
    .pill.on { background: var(--ink); color: var(--paper); }
    .pill:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1.75rem 1.25rem; }

    .panel-wrap { position: relative; }
    .panel { display: block; text-decoration: none; color: var(--ink); border: 3px solid var(--ink); background: var(--panel-bg); transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .panel:hover { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--ink); }
    .panel:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .cover { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-bottom: 3px solid var(--ink); background: var(--paper); }
    .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cover-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 1rem; font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.1rem; background: repeating-linear-gradient(135deg, var(--paper), var(--paper) 10px, var(--hatch) 10px, var(--hatch) 11px); }
    .new { position: absolute; left: 0; top: 0; padding: 0.15rem 0.45rem; font-size: 0.65rem; font-weight: 700; background: var(--ink); color: var(--paper); }

    .panel-info { padding: 0.75rem 0.85rem 0.9rem; }
    .panel-info h2 { font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 600; margin: 0 0 0.4rem; line-height: 1.25; }
    .sub { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .updated { font-size: 0.75rem; color: var(--muted-text); }

    .status { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.5rem; border: 1.5px solid var(--ink); }
    .status-ongoing { background: var(--ink); color: var(--paper); }
    .status-hiatus { opacity: 0.55; }

    .unfollow { position: absolute; top: 0.4rem; right: 0.4rem; width: 1.6rem; height: 1.6rem; display: flex; align-items: center; justify-content: center; background: var(--paper); color: var(--ink); border: 1.5px solid var(--ink); font-size: 1rem; line-height: 1; cursor: pointer; padding: 0; }
    .unfollow:hover { background: var(--danger); border-color: var(--danger); color: var(--paper); }
    .unfollow:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .empty, .loading { font-family: 'Fraunces', serif; font-size: 1.1rem; }
    .empty a { display: inline-block; margin-top: 0.75rem; color: var(--accent); font-weight: 600; text-decoration: underline; }
</style>

@code {
    private List<FollowedSeriesItem> _items = new();
    private bool _loaded;
    private bool _sortByUpdates = true;
    private string? _userId;

    private IEnumerable<FollowedSeriesItem> Sorted => _sortByUpdates
        ? _items.OrderByDescending(i => i.HasNewChapter).ThenByDescending(i => i.LastChapterAt ?? DateTime.MinValue)
        : _items.OrderByDescending(i => i.FollowedAt);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var follows = await Db.Follows
            .Include(f => f.Series)
                .ThenInclude(s => s.Chapters)
            .Where(f => f.UserId == _userId)
            .ToListAsync();

        _items = follows.Select(f =>
        {
            var published = f.Series.Chapters.Where(c => !c.IsDraft && c.PublishedAt <= DateTime.UtcNow).ToList();
            var lastAt = published.Count > 0 ? published.Max(c => c.PublishedAt) : null;
            return new FollowedSeriesItem
            {
                Series = f.Series,
                FollowedAt = f.FollowedAt,
                LastChapterAt = lastAt,
                HasNewChapter = published.Any(c => c.PublishedAt > (f.LastViewedAt ?? f.FollowedAt))
            };
        }).ToList();

        _loaded = true;
    }

    private async Task Unfollow(FollowedSeriesItem item)
    {
        if (_userId is null)
        {
            return;
        }

        var existing = await Db.Follows.FindAsync(_userId, item.Series.Id);
        if (existing is not null)
        {
            Db.Follows.Remove(existing);
            await Db.SaveChangesAsync();
        }

        _items.Remove(item);
    }

    private class FollowedSeriesItem
    {
        public Series Series { get; set; } = null!;
        public bool HasNewChapter { get; set; }
        public DateTime FollowedAt { get; set; }
        public DateTime? LastChapterAt { get; set; }
    }
}
