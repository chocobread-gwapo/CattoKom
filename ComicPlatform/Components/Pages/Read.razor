@page "/read/{SeriesId:int}/{ChapterNumber:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ComicPlatform.Data
@using ComicPlatform.Models
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthProvider

<PageTitle>@(_chapter?.Series.Title ?? "Loading") - Ch. @ChapterNumber</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

@if (_chapter is null)
{
    <p class="loading">Loading...</p>
}
else
{
    <div class="reader">
        <a class="back-link" href="@($"/series/{SeriesId}")">&laquo; @_chapter.Series.Title</a>

        <div class="reader-header">
            <h1>@_chapter.Series.Title</h1>
            <h2>Chapter @_chapter.Number: @_chapter.Title</h2>
        </div>

        <div class="reader-pages">
            @foreach (var pg in _chapter.Pages.OrderBy(p => p.PageNumber))
            {
                <img src="@pg.ImageUrl" alt="Page @pg.PageNumber" class="reader-page-image" />
            }
        </div>

        <div class="like-section">
            @if (_currentUserId is not null)
            {
                <button class="like-button @(_hasLiked ? "liked" : "")" @onclick="ToggleLike">
                    @(_hasLiked ? "♥ Liked" : "♡ Like")
                </button>
            }
            else
            {
                <a class="like-login-prompt" href="/Account/Login">Log in to like this chapter</a>
            }
            <span class="like-count">@_likeCount like@(_likeCount == 1 ? "" : "s")</span>
        </div>

        <div class="reader-nav">
            @if (_previousChapterNumber is not null)
            {
                <a href="/read/@SeriesId/@_previousChapterNumber">&laquo; Previous</a>
            }
            else
            {
                <span></span>
            }
            @if (_nextChapterNumber is not null)
            {
                <a href="/read/@SeriesId/@_nextChapterNumber">Next &raquo;</a>
            }
        </div>

        <div class="comments-section">
            <h2>Comments (@_comments.Count)</h2>

            <AuthorizeView>
                <Authorized Context="authState">
                    <EditForm Model="_commentModel" OnValidSubmit="HandleCommentSubmit" FormName="CommentForm" class="comment-form">
                        <InputTextArea @bind-Value="_commentModel.Content" placeholder="Add a comment..." rows="3" />
                        <button type="submit">Post Comment</button>
                    </EditForm>
                </Authorized>
                <NotAuthorized>
                    <p class="login-prompt"><a href="/Account/Login">Log in</a> to leave a comment.</p>
                </NotAuthorized>
            </AuthorizeView>

            <div class="comment-list">
                @if (_comments.Count == 0)
                {
                    <p class="no-comments">No comments yet — be the first.</p>
                }
                else
                {
                    @foreach (var comment in _comments)
                    {
                        <div class="comment">
                            <div class="comment-meta">
                                <span class="comment-author">@comment.User.DisplayName</span>
                                <span class="comment-date">@comment.CreatedAt.ToString("MMM d, yyyy")</span>
                                @if (_currentUserId is not null && (comment.UserId == _currentUserId || _chapter.Series.CreatorId == _currentUserId))
                                {
                                    <button type="button" class="comment-delete" @onclick="() => DeleteComment(comment)">Delete</button>
                                }
                            </div>
                            <p class="comment-content">@comment.Content</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<style>
    .loading {
        font-family: 'Fraunces', serif;
        text-align: center;
        padding: 3rem 0;
    }

    .reader {
        font-family: 'Public Sans', sans-serif;
        background: var(--paper);
        color: var(--ink);
        min-height: 100vh;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 1.5rem;
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .reader-header {
        text-align: center;
        padding-bottom: 1.5rem;
        border-bottom: 3px solid var(--ink);
        margin-bottom: 1.5rem;
    }

    .reader-header h1 {
        font-family: 'Fraunces', serif;
        font-weight: 900;
        font-size: clamp(1.5rem, 4vw, 2rem);
        margin: 0 0 0.35rem;
    }

    .reader-header h2 {
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-weight: 500;
        font-size: 1.1rem;
        color: var(--accent);
        margin: 0;
    }

    .reader-pages {
        display: flex;
        flex-direction: column;
    }

    .reader-page-image {
        width: 100%;
        display: block;
    }

    .like-section {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem 0;
        border-top: 1.5px solid var(--border-soft);
        border-bottom: 1.5px solid var(--border-soft);
    }

    .like-button {
        background: transparent;
        border: 3px solid var(--ink);
        color: var(--ink);
        padding: 0.6rem 1.25rem;
        font-family: 'Public Sans', sans-serif;
        font-weight: 600;
        cursor: pointer;
    }

    .like-button:hover {
        background: var(--panel-bg);
    }

    .like-button.liked {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--paper);
    }

    .like-button.liked:hover {
        background: var(--ink);
        border-color: var(--ink);
    }

    .like-login-prompt {
        color: var(--accent);
        font-weight: 600;
        text-decoration: underline;
    }

    .like-count {
        color: var(--accent);
        font-weight: 600;
    }

    .reader-nav {
        display: flex;
        justify-content: space-between;
        padding: 1.5rem 0;
        font-weight: 600;
    }

    .reader-nav a {
        color: var(--ink);
        text-decoration: none;
    }

    .reader-nav a:hover {
        color: var(--accent);
    }

    .comments-section {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 3px solid var(--ink);
    }

    .comments-section h2 {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.4rem;
        margin: 0 0 1.25rem;
    }

    .comment-form textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1.5px solid var(--ink);
        font-family: 'Public Sans', sans-serif;
        font-size: 0.95rem;
        resize: vertical;
        box-sizing: border-box;
        background: var(--panel-bg);
        color: var(--ink);
    }

    .comment-form button {
        margin-top: 0.6rem;
        background: var(--ink);
        color: var(--paper);
        border: none;
        padding: 0.55rem 1.25rem;
        font-weight: 600;
        cursor: pointer;
    }

    .comment-form button:hover {
        background: var(--accent);
    }

    .login-prompt {
        font-family: 'Fraunces', serif;
        font-style: italic;
    }

    .login-prompt a {
        color: var(--accent);
    }

    .comment-list {
        margin-top: 2rem;
    }

    .comment {
        padding: 1rem 0;
        border-bottom: 1.5px solid var(--border-soft);
    }

    .comment-meta {
        margin-bottom: 0.3rem;
    }

    .comment-author {
        font-weight: 600;
    }

    .comment-date {
        color: var(--accent);
        font-size: 0.85rem;
        margin-left: 0.5rem;
    }

    .comment-delete {
        background: none;
        border: none;
        color: var(--danger);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
        margin-left: 0.6rem;
        padding: 0;
    }

    .comment-delete:hover {
        color: var(--ink);
    }

    .comment-content {
        line-height: 1.55;
        margin: 0;
    }

    .no-comments {
        font-family: 'Fraunces', serif;
        font-style: italic;
        opacity: 0.6;
    }
</style>

@code {
    [Parameter] public int SeriesId { get; set; }
    [Parameter] public int ChapterNumber { get; set; }

    private Chapter? _chapter;
    private int? _previousChapterNumber;
    private int? _nextChapterNumber;
    private List<Comment> _comments = new();
    private readonly CommentFormModel _commentModel = new();
    private string? _currentUserId;
    private int _likeCount;
    private bool _hasLiked;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        _chapter = await Db.Chapters
            .Include(c => c.Series)
            .Include(c => c.Pages)
            .FirstOrDefaultAsync(c => c.SeriesId == SeriesId && c.Number == ChapterNumber && !c.IsDraft && c.PublishedAt <= DateTime.UtcNow);

        if (_chapter is not null)
        {
            _chapter.ViewCount++;
            await Db.SaveChangesAsync();

            _previousChapterNumber = await Db.Chapters
                .Where(c => c.SeriesId == SeriesId && c.Number < ChapterNumber && !c.IsDraft && c.PublishedAt <= DateTime.UtcNow)
                .OrderByDescending(c => c.Number)
                .Select(c => (int?)c.Number)
                .FirstOrDefaultAsync();

            _nextChapterNumber = await Db.Chapters
                .Where(c => c.SeriesId == SeriesId && c.Number > ChapterNumber && !c.IsDraft && c.PublishedAt <= DateTime.UtcNow)
                .OrderBy(c => c.Number)
                .Select(c => (int?)c.Number)
                .FirstOrDefaultAsync();

            _likeCount = await Db.Likes.CountAsync(l => l.ChapterId == _chapter.Id);

            if (_currentUserId is not null)
            {
                _hasLiked = await Db.Likes.AnyAsync(l => l.ChapterId == _chapter.Id && l.UserId == _currentUserId);
            }

            await LoadComments();
        }
    }

    private async Task ToggleLike()
    {
        if (_currentUserId is null || _chapter is null)
        {
            return;
        }

        if (_hasLiked)
        {
            var existing = await Db.Likes.FindAsync(_currentUserId, _chapter.Id);
            if (existing is not null)
            {
                Db.Likes.Remove(existing);
            }
        }
        else
        {
            Db.Likes.Add(new Like
            {
                UserId = _currentUserId,
                ChapterId = _chapter.Id
            });
        }

        await Db.SaveChangesAsync();
        _hasLiked = !_hasLiked;
        _likeCount += _hasLiked ? 1 : -1;
    }

    private async Task LoadComments()
    {
        if (_chapter is null)
        {
            return;
        }

        _comments = await Db.Comments
            .Include(c => c.User)
            .Where(c => c.ChapterId == _chapter.Id)
            .OrderByDescending(c => c.CreatedAt)
            .ToListAsync();
    }

    private async Task HandleCommentSubmit()
    {
        if (_chapter is null || _currentUserId is null || string.IsNullOrWhiteSpace(_commentModel.Content))
        {
            return;
        }

        Db.Comments.Add(new Comment
        {
            ChapterId = _chapter.Id,
            UserId = _currentUserId,
            Content = _commentModel.Content.Trim()
        });

        await Db.SaveChangesAsync();

        _commentModel.Content = string.Empty;
        await LoadComments();
    }

    private async Task DeleteComment(Comment comment)
    {
        if (_currentUserId is null || _chapter is null)
        {
            return;
        }

        var canDelete = comment.UserId == _currentUserId || _chapter.Series.CreatorId == _currentUserId;

        if (!canDelete)
        {
            return;
        }

        Db.Comments.Remove(comment);
        await Db.SaveChangesAsync();

        await LoadComments();
    }

    private class CommentFormModel
    {
        [Required, MaxLength(2000)]
        public string Content { get; set; } = string.Empty;
    }
}
