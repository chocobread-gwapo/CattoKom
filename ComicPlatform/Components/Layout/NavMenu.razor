@implements IDisposable
@using ComicPlatform.Components.Shared

@inject NavigationManager NavigationManager

<nav class="topnav" aria-label="Main">
    <a class="brand" href=""><Logo /> Catkoom</a>

    <div class="links">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink class="nav-link" href="categories">Categories</NavLink>
        <NavLink class="nav-link" href="rankings">Rankings</NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link" href="following">Following</NavLink>

                <AuthorizeView Roles="Admin" Context="adminAuth">
                    <NavLink class="nav-link" href="admin">Admin</NavLink>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="right">
        @ChildContent

        <AuthorizeView>
            <Authorized>
                <a class="btn-solid" href="creator/my-series">Dashboard</a>
                <NavLink class="pill-link" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="pill-link">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="pill-link" href="Account/Login">Login</NavLink>
                <a class="btn-solid" href="Account/Register">Register</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
